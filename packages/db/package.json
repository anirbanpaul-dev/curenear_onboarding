{
  "name": "@curenear/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "tsx seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts"
  },
  "prisma": {
    "seed": "tsx seed.ts"
  },
  "dependencies": {
    "@curenear/shared": "workspace:*",
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "hash-wasm": "^4.13.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "2.1.9",
    "prisma": "^6.2.1",
    "testcontainers": "^10.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
