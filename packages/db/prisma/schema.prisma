// CureNear Provider Onboarding Portal — data model.
// Conventions: UTC timestamps, integer paise for money, 6-digit PIN codes stored
// as Char(6), soft delete for users/providers, `version` for optimistic locking.
// Foundation tables (users, sessions, password_reset_tokens, audit_logs,
// outbox_events, idempotency_keys, settings) use snake_case table and column names
// via @@map/@map; TypeScript field names stay camelCase. Provider tables keep their
// original names until the provider phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ProviderType {
  doctor
  clinic
  pharmacy
  diagnostic_centre
  care_provider
}

enum ProviderStatus {
  draft
  submitted
  under_review
  changes_requested
  approved_not_live
  live
  suspended
  rejected
  terminated
}

enum VerificationStatus {
  pending
  verified
  rejected
  expired
  not_applicable
}

enum PinKind {
  registered_office
  location
  service_area
}

/// Type of regulator. The councils themselves live in `councils`, not in code.
enum CouncilKind {
  medical
  pharmacy
  nursing
  other
}

/// Lifecycle of a provider organization (docs/field-spec.md section 2).
/// Deliberately separate from `ProviderStatus`: this model is the normalized
/// replacement for the flat onboarding form and uses the uppercase states the
/// provider data model specifies.
/// What the provider (or their authorized signatory) agreed to. Declarations
/// are stored one row per declaration key, with the exact text version shown.
enum ConsentType {
  publication
  data_privacy_notice
  declarations
  doctor_confirmation
  agreement

  @@map("ConsentType")
}

/// How the consent was captured. `LINK_CONFIRMATION` is the tokenised public
/// page; `OTP` and the others are recorded for evidence purposes.
enum ConsentMethod {
  SIGNED_FORM_UPLOAD
  OTP
  LINK_CONFIRMATION
  IN_PERSON_ATTESTATION

  @@map("ConsentMethod")
}

enum AgreementTemplateStatus {
  draft
  active
  retired

  @@map("AgreementTemplateStatus")
}

enum ProviderOrganizationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SUSPENDED
  REJECTED
  TERMINATED
}

/// Doctor profile lifecycle, including the clinic-invitation states in
/// docs/field-spec.md section 6.5.
enum DoctorProfileStatus {
  invited
  doctor_confirmed
  under_review
  approved
  changes_requested
  rejected
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  name               String
  mobile             String?
  passwordHash       String     @map("password_hash")
  role               Role
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until")
  lastLoginAt        DateTime?  @map("last_login_at")
  employeeCode       String?    @unique @map("employee_code")
  createdByUserId    String?    @map("created_by_user_id") @db.Uuid
  version            Int        @default(1)
  deletedAt          DateTime?  @map("deleted_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  createdBy                 User?                        @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers              User[]                       @relation("UserCreator")
  sessions                  Session[]
  passwordResets            PasswordResetToken[]
  createdProviders          Provider[]                   @relation("ProviderCreator")
  reviewedProviders         Provider[]                   @relation("ProviderReviewer")
  createdOrganizations      ProviderOrganization[]       @relation("ProviderOrganizationCreator")
  approvedOrganizations     ProviderOrganization[]       @relation("ProviderOrganizationApprover")
  providerStatusChanges     ProviderStatusHistory[]
  uploadedProviderDocuments ProviderDocument[]
  uploadedDocuments         Document[]                   @relation("DocumentUploadedBy")
  verifiedDocuments         Document[]                   @relation("DocumentVerifiedBy")
  auditEntries              AuditLog[]
  pinAssignments            StaffPinAssignment[]         @relation("StaffPinAssignments")
  duplicateDismissals       ProviderDuplicateDismissal[]
  verifications             VerificationRecord[]
  revisions                 ProviderRevision[]
  settingsUpdated           Setting[]                    @relation("SettingUpdatedBy")
  providerDirectoryViews    ProviderDirectoryView[]      @relation("ProviderDirectoryViews")
  capturedConsents          ConsentRecord[]              @relation("ConsentCapturedBy")
  recordedAgreements        AgreementAcceptance[]        @relation("AgreementRecordedBy")
  notifications             Notification[]
  exportJobs                ExportJob[]                   @relation("ExportJobsRequested")
  notificationPreferences   NotificationPreference[]

  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([createdByUserId])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime? @map("last_seen_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // (userId, expiresAt) also serves lookups by userId alone.
  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// Append-only: a database trigger rejects UPDATE and DELETE (see the foundation
// migration), so `updated_at` never moves after the insert.
model AuditLog {
  id               String          @id @default(uuid()) @db.Uuid
  occurredAt       DateTime        @default(now()) @map("occurred_at")
  actorUserId      String?         @map("actor_user_id") @db.Uuid
  actorRole        Role?           @map("actor_role")
  action           String
  entityType       String          @map("entity_type")
  entityId         String          @map("entity_id")
  before           Json?
  after            Json?
  requestId        String?         @map("request_id")
  changedFieldKeys String[]        @map("changed_field_keys")
  fromStatus       ProviderStatus? @map("from_status")
  toStatus         ProviderStatus? @map("to_status")
  reason           String?
  ipAddress        String?         @map("ip")
  userAgent        String?         @map("user_agent")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // The composites cover their leading columns; only createdAt needs its own index.
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type")
  eventVersion  Int       @default(1) @map("event_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  dedupeKey     String?   @unique @map("dedupe_key")
  occurredAt    DateTime  @default(now()) @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  /// Set once the retry budget is spent; the event is surfaced on
  /// /admin/system/events and no longer claimed by the publisher.
  deadLetteredAt DateTime? @map("dead_lettered_at")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([publishedAt, nextAttemptAt])
  @@index([deadLetteredAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("outbox_events")
}

// `response` holds what a replayed request gets back (today the created resource id;
// a full cached body can live here later). Scope is "<userId>:<endpoint>".
model IdempotencyKey {
  scope       String
  key         String
  requestHash String   @map("request_hash")
  response    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Setting {
  key       String   @id
  value     Json     @default("{}")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  updatedByUser User? @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("settings")
}

model Provider {
  id               String         @id @default(uuid()) @db.Uuid
  providerType     ProviderType
  status           ProviderStatus @default(draft)
  displayName      String?
  legalName        String?
  data             Json           @default("{}")
  primaryPinCode   String?        @db.Char(6)
  city             String?
  version          Int            @default(1)
  createdByUserId  String         @db.Uuid
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?        @db.Uuid
  decisionReason   String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  createdBy     User                 @relation("ProviderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy    User?                @relation("ProviderReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  pins          ProviderPinCode[]
  verifications VerificationRecord[]
  revisions     ProviderRevision[]

  @@index([providerType])
  @@index([status])
  @@index([createdByUserId])
  @@index([primaryPinCode])
  @@index([city])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([status, providerType, createdAt])
  @@index([createdByUserId, status])
}

/// Territory reference for a staff member. Informational only: it never grants
/// access to a provider.
model StaffPinAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  staffUserId String   @map("staff_user_id") @db.Uuid
  pinCode     String   @map("pin_code") @db.Char(6)
  createdAt   DateTime @default(now()) @map("created_at")

  staffUser User @relation("StaffPinAssignments", fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, pinCode])
  @@index([pinCode])
  @@map("staff_pin_assignments")
}

// --- Master data ----------------------------------------------------------
// Reference lists the whole system reads. They live in tables (never enums) so
// administrators can edit them without a deploy.

model State {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  districts             District[]
  pinCodes              PinCode[]
  councils              Council[]
  providerOrganizations ProviderOrganization[] @relation("ProviderOrganizationState")
  providerLocations     ProviderLocation[]     @relation("ProviderLocationState")

  @@map("states")
}

model District {
  id        String   @id @default(uuid()) @db.Uuid
  stateId   String   @map("state_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  state                 State                  @relation(fields: [stateId], references: [id], onDelete: Restrict)
  pinCodes              PinCode[]
  providerOrganizations ProviderOrganization[] @relation("ProviderOrganizationDistrict")
  providerLocations     ProviderLocation[]     @relation("ProviderLocationDistrict")

  @@unique([stateId, name])
  @@index([name])
  @@map("districts")
}

/// One row per PIN code (the India Post directory has several offices per PIN;
/// the import keeps one representative office).
model PinCode {
  pinCode    String   @id @map("pin_code") @db.Char(6)
  officeName String   @map("office_name")
  districtId String?  @map("district_id") @db.Uuid
  stateId    String?  @map("state_id") @db.Uuid
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  state    State?    @relation(fields: [stateId], references: [id], onDelete: SetNull)

  @@index([officeName])
  @@index([stateId])
  @@index([districtId])
  @@map("pin_codes")
}

model Specialty {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  /// allopathy | dental | ayurveda | homeopathy | unani | siddha | physiotherapy | other
  systemOfMedicine String   @map("system_of_medicine")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  doctorProfiles DoctorProfile[]

  @@index([systemOfMedicine])
  @@map("specialties")
}

model LicenceType {
  id                      String         @id @default(uuid()) @db.Uuid
  code                    String         @unique
  name                    String
  applicableProviderTypes ProviderType[] @map("applicable_provider_types")
  isActive                Boolean        @default(true) @map("is_active")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  providerLicences ProviderLicence[]

  @@map("licence_types")
}

model Council {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique
  name      String
  kind      CouncilKind
  /// Null for national regulators such as the NMC.
  stateId   String?     @map("state_id") @db.Uuid
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  state          State?          @relation(fields: [stateId], references: [id], onDelete: SetNull)
  doctorProfiles DoctorProfile[]

  @@index([kind])
  @@index([stateId])
  @@map("councils")
}

model ServiceCategory {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  name         String
  providerType ProviderType @map("provider_type")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([providerType])
  @@map("service_categories")
}

model FacilityType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("facility_types")
}

model DocumentType {
  id                 String         @id @default(uuid()) @db.Uuid
  code               String         @unique
  name               String
  providerTypes      ProviderType[] @map("provider_types")
  requiresExpiry     Boolean        @default(false) @map("requires_expiry")
  /// Days before expiry that reminders fire; empty when expiry is not tracked.
  expiryReminderDays Int[]          @map("expiry_reminder_days")
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  documents Document[]

  @@map("document_types")
}

model ProviderPinCode {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  pinCode    String   @db.Char(6)
  kind       PinKind
  createdAt  DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, pinCode])
  @@index([pinCode])
  @@index([providerId])
}

model ProviderRevision {
  id               String         @id @default(uuid()) @db.Uuid
  providerId       String         @db.Uuid
  version          Int
  status           ProviderStatus
  changedByUserId  String         @db.Uuid
  changedFieldKeys String[]
  snapshot         Json
  createdAt        DateTime       @default(now())

  provider  Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@unique([providerId, version])
  @@index([providerId, createdAt])
}

model VerificationRecord {
  id                   String             @id @default(uuid()) @db.Uuid
  providerId           String             @db.Uuid
  item                 String
  status               VerificationStatus @default(pending)
  verifiedByUserId     String?            @db.Uuid
  verifiedOn           DateTime?
  source               String?
  evidenceRef          String?
  reason               String?
  nextVerificationDate DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  provider             Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  verifiedByUserId_ref User?    @relation(fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@unique([providerId, item])
  @@index([providerId])
  @@index([status])
  @@index([nextVerificationDate])
  // The legacy flat-provider verification table. The admin review workflow
  // uses the normalized `verification_records` model below.
  @@map("legacy_verification_records")
}

/// Admin review checklist (field spec section 10). One row per document or
/// claim, either for an organization or for a doctor profile.
enum ReviewVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
  NOT_APPLICABLE

  @@map("ReviewVerificationStatus")
}

enum SuspensionScope {
  WHOLE_PROFILE
  LOCATION
  SERVICE_CATEGORY

  @@map("SuspensionScope")
}

model ReviewVerification {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String?                  @map("organization_id") @db.Uuid
  doctorProfileId  String?                  @map("doctor_profile_id") @db.Uuid
  item             String
  sectionKey       String?                  @map("section_key")
  required         Boolean                  @default(true)
  status           ReviewVerificationStatus @default(PENDING)
  verifiedByUserId String?                  @map("verified_by") @db.Uuid
  verifiedAt       DateTime?                @map("verified_at")
  source           String?
  evidenceRef      String?                  @map("evidence_ref")
  reason           String?
  nextVerificationOn DateTime?              @map("next_verification_on") @db.Date
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at")

  organization  ProviderOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile?        @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, item])
  @@unique([doctorProfileId, item])
  @@index([organizationId, status])
  @@map("verification_records")
}

/// A review comment thread, scoped to one registry section of a provider.
/// Staff see these when the application is returned for changes.
model ReviewComment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sectionKey     String   @map("section_key")
  authorUserId   String   @map("author_user_id") @db.Uuid
  authorRole     String   @map("author_role")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("review_comments")
}

/// One reviewer per application; "assign to me" writes this row.
model ReviewAssignment {
  organizationId   String   @id @map("organization_id") @db.Uuid
  reviewerUserId   String   @map("reviewer_user_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at")

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("review_assignments")
}

/// Singleton row (`id = 'default'`) with the configurable SLA thresholds.
model ReviewSettings {
  id              String   @id @default("default")
  slaWarnHours    Int      @default(48) @map("sla_warn_hours")
  slaBreachHours  Int      @default(72) @map("sla_breach_hours")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("review_settings")
}

// --- Provider data model --------------------------------------------------
// Common data lives in columns; type-specific data lives in `type_data` and is
// validated against the field registry in `packages/shared/src/fields`.
// `code` comes from a per-type database sequence (`next_provider_code()`).

model ProviderOrganization {
  id                    String                     @id @default(uuid()) @db.Uuid
  /// CN-PH-000123, from `next_provider_code(provider_type)`.
  code                  String                     @unique
  providerType          ProviderType               @map("provider_type")
  status                ProviderOrganizationStatus @default(DRAFT)
  legalName             String?                    @map("legal_name")
  tradeName             String?                    @map("trade_name")
  constitutionType      String?                    @map("constitution_type")
  registrationNumber    String?                    @map("registration_number")
  establishedOn         DateTime?                  @map("established_on") @db.Date
  website               String?
  email                 String?
  mobile                String?
  /// Denormalized from the primary location so discovery never joins. Keep in
  /// sync whenever the primary location changes.
  primaryPinCode        String?                    @map("primary_pin_code") @db.Char(6)
  primaryDistrictId     String?                    @map("primary_district_id") @db.Uuid
  primaryStateId        String?                    @map("primary_state_id") @db.Uuid
  typeData              Json                       @default("{}") @map("type_data")
  typeDataSchemaVersion Int                        @default(1) @map("type_data_schema_version")
  /// Public profile fields (display name, description, logo, languages).
  profileData           Json                       @default("{}") @map("profile_data")
  /// Per-field publication consent and the provider declarations.
  publicationConsents   Json                       @default("{}") @map("publication_consents")
  createdByUserId       String                     @map("created_by_user_id") @db.Uuid
  submittedAt           DateTime?                  @map("submitted_at")
  approvedAt            DateTime?                  @map("approved_at")
  approvedByUserId      String?                    @map("approved_by_user_id") @db.Uuid
  /// True when an always-required document (or licence document) is missing.
  /// Maintained by database triggers in migration 20260425000100; never write
  /// it from application code.
  documentGap           Boolean                    @default(false) @map("document_gap")
  /// Raised by the expiry job when a document or licence lapses; cleared when
  /// every live document is valid again. Never blocks approval on its own.
  complianceFlag        Boolean                    @default(false) @map("compliance_flag")
  complianceFlagReason  String?                    @map("compliance_flag_reason")
  /// Optimistic lock: services update with `where: { id, version }`.
  version               Int                        @default(1)
  deletedAt             DateTime?                  @map("deleted_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  createdBy             User                         @relation("ProviderOrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy            User?                        @relation("ProviderOrganizationApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  primaryDistrict       District?                    @relation("ProviderOrganizationDistrict", fields: [primaryDistrictId], references: [id], onDelete: SetNull)
  primaryState          State?                       @relation("ProviderOrganizationState", fields: [primaryStateId], references: [id], onDelete: SetNull)
  locations             ProviderLocation[]
  servicePins           ProviderServicePin[]
  contacts              ProviderContact[]
  licences              ProviderLicence[]
  insurance             ProviderInsurance[]
  documents             ProviderDocument[]
  doctorProfiles        DoctorProfile[]              @relation("DoctorProfileOrganization")
  createdDoctorProfiles DoctorProfile[]              @relation("DoctorProfileCreatedByOrg")
  doctorLocations       DoctorLocation[]             @relation("DoctorLocationClinic")
  statusHistory         ProviderStatusHistory[]
  pinContributions      ProviderPinContribution[]
  reviewVerifications   ReviewVerification[]
  reviewComments        ReviewComment[]
  reviewAssignment      ReviewAssignment?
  searchIndex           ProviderSearchIndex?
  duplicateDismissals   ProviderDuplicateDismissal[] @relation("DuplicateDismissals")
  dismissedAsDuplicate  ProviderDuplicateDismissal[] @relation("DuplicateDismissalsOf")
  consents              ConsentRecord[]              @relation("ConsentRecords")
  agreementAcceptances  AgreementAcceptance[]        @relation("AgreementAcceptances")
  confirmationRequests  ConfirmationRequest[]        @relation("ConfirmationRequests")

  // `(primary_pin_code, provider_type, status)` serves PIN-scoped discovery;
  // `(created_by_user_id, status)` serves "my applications".
  @@index([providerType, status])
  @@index([status, submittedAt])
  @@index([primaryPinCode])
  @@index([primaryPinCode, providerType, status])
  @@index([createdByUserId, status])
  @@index([deletedAt])
  @@index([primaryDistrictId])
  @@index([primaryStateId])
  @@map("provider_organizations")
}

/// A branch or premises. The registered office is the row with `is_primary`.
model ProviderLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  locationType   String   @map("location_type")
  addressLine1   String   @map("address_line1")
  addressLine2   String?  @map("address_line2")
  landmark       String?
  city           String
  districtId     String?  @map("district_id") @db.Uuid
  stateId        String?  @map("state_id") @db.Uuid
  pinCode        String   @map("pin_code") @db.Char(6)
  latitude       Float?
  longitude      Float?
  isPrimary      Boolean  @default(false) @map("is_primary")
  isPublic       Boolean  @default(false) @map("is_public")
  operatingHours Json     @default("{}") @map("operating_hours")
  bookingPhone   String?  @map("booking_phone")
  branchRef      String?  @map("branch_ref")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  district     District?            @relation("ProviderLocationDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  state        State?               @relation("ProviderLocationState", fields: [stateId], references: [id], onDelete: SetNull)
  licences     ProviderLicence[]
  doctorLinks  DoctorLocation[]

  @@index([organizationId])
  @@index([pinCode])
  @@index([organizationId, isPrimary])
  @@index([districtId])
  @@index([stateId])
  @@map("provider_locations")
}

/// Service, delivery or collection coverage. The unique triple keeps the
