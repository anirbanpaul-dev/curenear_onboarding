/// Uploaded document metadata. Binaries live in object storage; the field spec
/// keeps this portal free of clinical records.
model ProviderDocument {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  fileName         String    @map("file_name")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  storageKey       String?   @map("storage_key")
  /// Registry document role ("profile_logo", "medical_registration", ...).
  role             String?
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  organization    ProviderOrganization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy      User                  @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  licences        ProviderLicence[]
  insurance       ProviderInsurance[]
  doctors         DoctorProfile[]
  consentEvidence ConsentRecord[]       @relation("ConsentEvidence")
  agreementSigned AgreementAcceptance[] @relation("AgreementSignedDocument")

  @@index([organizationId])
  @@map("provider_documents")
}

enum DocumentOwnerType {
  provider
  provider_organization

  @@map("DocumentOwnerType")
}

/// `PENDING_SCAN` holds a confirmed upload while the malware scanner runs.
enum DocumentStatus {
  PENDING_SCAN
  UPLOADED
  VERIFIED
  REJECTED
  EXPIRED

  @@map("DocumentStatus")
}

/// The reusable document service: one row per uploaded file, for either owner
/// model. `expires_on` is indexed for the reminder job.
model Document {
  id               String            @id @default(uuid()) @db.Uuid
  ownerType        DocumentOwnerType @map("owner_type")
  ownerId          String            @map("owner_id") @db.Uuid
  documentTypeId   String            @map("document_type_id") @db.Uuid
  fileName         String            @map("file_name")
  mimeType         String            @map("mime_type")
  sizeBytes        Int               @map("size_bytes")
  storageKey       String            @unique @map("storage_key")
  checksumSha256   String?           @map("checksum_sha256") @db.Char(64)
  status           DocumentStatus    @default(UPLOADED)
  expiresOn        DateTime?         @map("expires_on") @db.Date
  uploadedByUserId String            @map("uploaded_by") @db.Uuid
  verifiedByUserId String?           @map("verified_by") @db.Uuid
  verifiedAt       DateTime?         @map("verified_at")
  rejectionReason  String?           @map("rejection_reason")
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  uploadedBy   User         @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  verifiedBy   User?        @relation("DocumentVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId])
  @@index([documentTypeId])
  @@index([expiresOn])
  @@index([status, expiresOn])
  @@map("documents")
}

/// A doctor is its own record and can be linked to many clinics.
/// Rule for `organization_id`: it is required once the profile belongs to a
/// doctor organization. While a clinic has added the doctor, the profile is
/// clinic-owned (`created_by_org_id` set) and `organization_id` stays NULL until
/// the doctor confirms (`doctor_confirmed_at`); a CHECK constraint in the
/// migration enforces it.
model DoctorProfile {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String?             @map("organization_id") @db.Uuid
  fullName          String              @map("full_name")
  /// Invite contact captured when a clinic adds the doctor (Section 6.5).
  mobile            String?
  email             String?
  registrationNo    String              @map("registration_no")
  councilId         String?             @map("council_id") @db.Uuid
  /// The council as the registry captured it, even when master data has no match.
  councilName       String?             @map("council_name")
  systemOfMedicine  String              @map("system_of_medicine")
  specialtyId       String?             @map("specialty_id") @db.Uuid
  specialtyName     String?             @map("specialty_name")
  qualifications    Json                @default("[]")
  photoDocumentId   String?             @map("photo_document_id") @db.Uuid
  status            DoctorProfileStatus @default(invited)
  /// The clinic that added the doctor; NULL for self-onboarded doctors.
  createdByOrgId    String?             @map("created_by_org_id") @db.Uuid
  doctorConfirmedAt DateTime?           @map("doctor_confirmed_at")
  deletedAt         DateTime?           @map("deleted_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  organization  ProviderOrganization? @relation("DoctorProfileOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  createdByOrg  ProviderOrganization? @relation("DoctorProfileCreatedByOrg", fields: [createdByOrgId], references: [id], onDelete: SetNull)
  council       Council?              @relation(fields: [councilId], references: [id], onDelete: SetNull)
  specialty     Specialty?            @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  photoDocument ProviderDocument?     @relation(fields: [photoDocumentId], references: [id], onDelete: SetNull)
  locations     DoctorLocation[]
  consents      ConsentRecord[]       @relation("ConsentRecords")
  verifications ReviewVerification[]

  // One live profile per (registration number, council). The partial unique
  // index lives in the migration (`WHERE deleted_at IS NULL`).
  @@index([registrationNo, councilId])
  @@index([organizationId])
  @@index([createdByOrgId])
  @@index([deletedAt])
  @@map("doctor_profiles")
}

/// A doctor's practice link. A link points at either a specific location or a
/// clinic organization (the clinic's own branches decide the venue).
model DoctorLocation {
  id                   String   @id @default(uuid()) @db.Uuid
  doctorProfileId      String   @map("doctor_profile_id") @db.Uuid
  locationId           String?  @map("location_id") @db.Uuid
  clinicOrganizationId String?  @map("clinic_organization_id") @db.Uuid
  roleAtClinic         String?  @map("role_at_clinic")
  /// Standalone practice metadata (Doctor 4.3); clinic links use `clinic`.
  practiceType         String?  @map("practice_type")
  address              Json?
  publicContact        String?  @map("public_contact")
  timings              Json     @default("{}")
  feePaise             Int?     @map("fee_paise")
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  doctorProfile DoctorProfile         @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  location      ProviderLocation?     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  clinic        ProviderOrganization? @relation("DoctorLocationClinic", fields: [clinicOrganizationId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId])
  @@index([locationId])
  @@index([clinicOrganizationId])
  @@map("doctor_locations")
}

model ProviderStatusHistory {
  id              String                      @id @default(uuid()) @db.Uuid
  organizationId  String                      @map("organization_id") @db.Uuid
  fromStatus      ProviderOrganizationStatus? @map("from_status")
  toStatus        ProviderOrganizationStatus  @map("to_status")
  changedByUserId String                      @map("changed_by_user_id") @db.Uuid
  reason          String?
  /// Suspension / reinstatement scope and the affected location or service kind.
  scope           SuspensionScope?
  scopeRefId      String?                     @map("scope_ref_id") @db.Uuid
  scopeLabel      String?                     @map("scope_label")
  /// Sections the reviewer flagged when requesting changes.
  flaggedSections String[]                    @default([]) @map("flagged_sections")
  at              DateTime                    @default(now())

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedBy    User                 @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, at])
  @@map("provider_status_history")
}

/// PIN roll-up read model. Recomputed from provider locations and service pins
/// by `refreshProviderPinStats`; it is a cache, never a source of truth.
/// An operator has compared two providers and decided they are not duplicates,
/// so the warning is not shown again for this pair.
/// One captured consent. `evidence_document_id` points at the signed form or
/// scan when the method required an upload. Rows are never rewritten except to
/// revoke them, so the version and timestamp stay intact.
model ConsentRecord {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  doctorProfileId    String?       @map("doctor_profile_id") @db.Uuid
  consentType        ConsentType   @map("consent_type")
  /// Exact text/version shown to the provider: `2026-11-21` or a template version.
  textVersion        String        @map("text_version")
  capturedByUserId   String?       @map("captured_by_user_id") @db.Uuid
  capturedAt         DateTime      @default(now()) @map("captured_at")
  method             ConsentMethod
  evidenceDocumentId String?       @map("evidence_document_id") @db.Uuid
  /// Declaration key, template id, signatory details or OTP challenge reference.
  confirmationMeta   Json          @default("{}") @map("confirmation_meta")
  revokedAt          DateTime?     @map("revoked_at")
  revokedByUserId    String?       @map("revoked_by_user_id") @db.Uuid
  revokeReason       String?       @map("revoke_reason")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")

  organization     ProviderOrganization @relation("ConsentRecords", fields: [organizationId], references: [id], onDelete: Cascade)
  doctorProfile    DoctorProfile?       @relation("ConsentRecords", fields: [doctorProfileId], references: [id], onDelete: SetNull)
  capturedBy       User?                @relation("ConsentCapturedBy", fields: [capturedByUserId], references: [id], onDelete: SetNull)
  evidenceDocument ProviderDocument?    @relation("ConsentEvidence", fields: [evidenceDocumentId], references: [id], onDelete: SetNull)

  @@index([organizationId, consentType])
  @@index([doctorProfileId])
  @@index([revokedAt])
  @@map("consent_records")
}

/// A partner agreement template. `body` is the source of the pre-filled PDF and
/// `body_hash` pins the exact text the acceptance refers to.
model AgreementTemplate {
  id             String                  @id @default(uuid()) @db.Uuid
  providerType   ProviderType            @map("provider_type")
  name           String
  version        String
  effectiveFrom  DateTime                @map("effective_from") @db.Date
  body           String
  bodyHash       String                  @map("body_hash")
  fileDocumentId String?                 @map("file_document_id") @db.Uuid
  status         AgreementTemplateStatus @default(active)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at")

  acceptances AgreementAcceptance[]

  @@unique([providerType, version])
  @@index([providerType, status])
  @@map("agreement_templates")
}

/// A physical or e-signed execution of a template. `stamp_reference` is
/// admin-only and never shown on the provider-facing screens.
model AgreementAcceptance {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  templateId           String        @map("template_id") @db.Uuid
  method               ConsentMethod
  signedOn             DateTime      @map("signed_on") @db.Date
  place                String
  signatoryName        String        @map("signatory_name")
  signatoryDesignation String        @map("signatory_designation")
  signedDocumentId     String?       @map("signed_document_id") @db.Uuid
  stampReference       String?       @map("stamp_reference")
  witnesses            Json          @default("[]")
  recordedByUserId     String?       @map("recorded_by_user_id") @db.Uuid
  revokedAt            DateTime?     @map("revoked_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at")

  organization   ProviderOrganization @relation("AgreementAcceptances", fields: [organizationId], references: [id], onDelete: Cascade)
  template       AgreementTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  signedDocument ProviderDocument?    @relation("AgreementSignedDocument", fields: [signedDocumentId], references: [id], onDelete: SetNull)
  recordedBy     User?                @relation("AgreementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([templateId])
  @@map("agreement_acceptances")
}

/// A tokenised, unauthenticated confirmation link. Only the SHA-256 hash of the
/// token is stored; the link expires after 48 hours and is single-use.
model ConfirmationRequest {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  doctorProfileId  String?   @map("doctor_profile_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  revokedAt        DateTime? @map("revoked_at")
  /// OTP challenge state (hashed code, phone, attempts) for the SMS provider.
  confirmationMeta Json      @default("{}") @map("confirmation_meta")
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  organization ProviderOrganization @relation("ConfirmationRequests", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([expiresAt])
  @@map("confirmation_requests")
}

model ProviderDuplicateDismissal {
  id                      String   @id @default(uuid()) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  duplicateOrganizationId String   @map("duplicate_organization_id") @db.Uuid
  dismissedByUserId       String   @map("dismissed_by_user_id") @db.Uuid
  reason                  String?
  createdAt               DateTime @default(now()) @map("created_at")

  organization          ProviderOrganization @relation("DuplicateDismissals", fields: [organizationId], references: [id], onDelete: Cascade)
  duplicateOrganization ProviderOrganization @relation("DuplicateDismissalsOf", fields: [duplicateOrganizationId], references: [id], onDelete: Cascade)
  dismissedBy           User                 @relation(fields: [dismissedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, duplicateOrganizationId])
  @@index([duplicateOrganizationId])
  @@map("provider_duplicate_dismissals")
}

/// A named filter preset for the admin provider directory. Views are personal:
/// the same staff member can keep "Kolkata pharmacies awaiting review" and
/// open it from any browser. `query` is the URL query string, so a view and a
/// shared link are the same thing.
model ProviderDirectoryView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  query     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("ProviderDirectoryViews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("provider_directory_views")
}

/// Which question a PIN row answers. `primary` counts a provider once at its
/// primary location PIN; `doctor_practice` counts a doctor at each active
/// practice PIN; `service` counts a provider at each service-area PIN.
enum PinStatMeasure {
  primary
  doctor_practice
  service

  @@map("PinStatMeasure")
}

model ProviderPinStats {
  pinCode      String                     @map("pin_code") @db.Char(6)
  providerType ProviderType               @map("provider_type")
  status       ProviderOrganizationStatus
  measure      PinStatMeasure             @default(primary)
  count        Int
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  @@id([pinCode, providerType, status, measure])
  @@index([measure, providerType, status])
  @@map("provider_pin_stats")
}

/// What one organisation currently contributes to the read model, keyed by the
/// thing being counted (`subject_id`: the organisation, or a doctor profile for
/// the doctor-practice measure). Incremental updates diff this against the live
/// state, so PIN changes and deletes subtract exactly what was added before.
model ProviderPinContribution {
  measure        PinStatMeasure
  subjectId      String                     @map("subject_id") @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  pinCode        String                     @map("pin_code") @db.Char(6)
  providerType   ProviderType               @map("provider_type")
  status         ProviderOrganizationStatus

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([measure, subjectId, pinCode])
  @@index([organizationId])
  @@map("provider_pin_contributions")
}

// --- Event-driven system ------------------------------------------------
// Notifications are written by the worker's event handlers and also lazily by
// scheduled jobs. `(user_id, type, event_id)` makes event fan-out idempotent.

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  title      String
  body       String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  eventId    String?   @map("event_id") @db.Uuid
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, eventId])
  @@index([userId, readAt, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

enum ExportType {
  providers
  pin_summary
  staff_performance
  expiring_documents

  @@map("ExportType")
}

enum ExportStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED

  @@map("ExportStatus")
}

/// The private-storage object behind a finished CSV export. Exports are not
/// provider documents, so they never appear in a provider's document list.
model ExportFile {
  id             String      @id @default(uuid()) @db.Uuid
  storageKey     String      @unique @map("storage_key")
  fileName       String      @map("file_name")
  mimeType       String      @map("mime_type")
  sizeBytes      Int         @map("size_bytes")
  checksumSha256 String?     @map("checksum_sha256") @db.Char(64)
  createdAt      DateTime    @default(now()) @map("created_at")
  jobs           ExportJob[]

  @@map("export_files")
}

/// One asynchronous export request. The worker streams the CSV into private
/// storage, records the row count and notifies the requester. `expires_at` is
/// the last moment the download route will sign a URL; a daily job marks the
/// job EXPIRED and removes the object.
model ExportJob {
  id                String       @id @default(uuid()) @db.Uuid
  type              ExportType
  status            ExportStatus @default(QUEUED)
  requestedByUserId String       @map("requested_by_user_id") @db.Uuid
  filters           Json         @default("{}")
  rowCount          Int?         @map("row_count")
  fileDocumentId    String?      @map("file_document_id") @db.Uuid
  expiresAt         DateTime     @map("expires_at")
  startedAt         DateTime?    @map("started_at")
  finishedAt        DateTime?    @map("finished_at")
  error             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")

  requestedBy  User        @relation("ExportJobsRequested", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  fileDocument ExportFile? @relation(fields: [fileDocumentId], references: [id], onDelete: SetNull)

  @@index([requestedByUserId, status])
  @@index([status, createdAt])
  @@map("export_jobs")
}

/// Absent row means the catalogue default for that type.
model NotificationPreference {
  userId    String   @map("user_id") @db.Uuid
  type      String
  inApp     Boolean  @default(true) @map("in_app")
  email     Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

/// One row per (event, handler): a replayed event never runs a handler twice.
model ProcessedEventHandler {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, handler])
  @@index([processedAt])
  @@map("processed_event_handlers")
}

/// History for /admin/system/jobs; written by every pg-boss handler.
model JobRun {
  id         String   @id @default(uuid()) @db.Uuid
  queue      String
  status     String
  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")
  durationMs Int      @map("duration_ms")
  summary    Json     @default("{}")
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([queue, startedAt])
  @@index([startedAt])
  @@map("job_runs")
}

model WebhookEndpoint {
  id          String   @id @default(uuid()) @db.Uuid
  url         String   @unique
  description String?
  eventTypes  String[] @default([]) @map("event_types")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

/// One row per (endpoint, event). The worker delivers pending rows with
/// exponential backoff and keeps FAILED rows for inspection.
model WebhookDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  endpointId    String    @map("endpoint_id") @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastError     String?   @map("last_error")
  deliveredAt   DateTime? @map("delivered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Denormalized fields refreshed by the `search-index` handler.
model ProviderSearchIndex {
  organizationId String                     @id @map("organization_id") @db.Uuid
  code           String
  providerType   ProviderType               @map("provider_type")
  status         ProviderOrganizationStatus
  primaryPinCode String?                    @map("primary_pin_code") @db.Char(6)
  legalName      String?                    @map("legal_name")
  city           String?
  doctorCount    Int                        @default(0) @map("doctor_count")
  indexedAt      DateTime                   @default(now()) @map("indexed_at")

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([primaryPinCode, status])
  @@index([providerType, status])
  @@map("provider_search_index")
}
