  number         String
  authority      String?
  issuedOn       DateTime? @map("issued_on") @db.Date
  validFrom      DateTime? @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  status         String    @default("active")
  documentId     String?   @map("document_id") @db.Uuid
  details        Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     ProviderLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  licenceType  LicenceType?         @relation(fields: [licenceTypeId], references: [id], onDelete: SetNull)
  document     ProviderDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([licenceTypeId])
  @@index([validTo])
  @@map("provider_licences")
}

model ProviderInsurance {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  type           String
  insurer        String
  policyNo       String    @map("policy_no")
  limitPaise     Int?      @map("limit_paise")
  validFrom      DateTime? @map("valid_from") @db.Date
