model ProviderServicePin {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pinCode        String   @map("pin_code") @db.Char(6)
  serviceKind    String   @map("service_kind")
  createdAt      DateTime @default(now()) @map("created_at")

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pinCode, serviceKind])
  @@index([pinCode])
  @@index([organizationId])
  @@map("provider_service_pins")
}

model ProviderContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           String
  name           String
  designation    String?
  phone          String
  email          String?
  /// Legal-notice contacts carry a postal address; role contacts leave it null.
  address        Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
  @@map("provider_contacts")
}

model ProviderLicence {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  locationId     String?   @map("location_id") @db.Uuid
