# Production environment template. Copy into the platform's secret store or a
# server-side .env file with mode 600. Never commit the filled-in file.
#
# Changes from local:
#   - NODE_ENV is production, so HSTS is emitted and secure cookies are expected.
#   - APP_URL must be the public HTTPS origin; it drives same-origin checks.
#   - Use a private S3-compatible bucket, not MinIO, and provider-managed TLS.
#   - SMTP must be a deliverable provider domain with SPF/DKIM/DMARC.
#   - SEED_ADMIN_* is needed only for the one-off first-admin seed; remove it after.

NODE_ENV=production
APP_URL=https://CHANGE_ME.example.com
LOG_LEVEL=info

# Use the provider's TLS connection string. Keep the worker on a direct
# (session-level) connection; serverless web instances use the pooled URL.
DATABASE_URL=postgresql://USER:CHANGE_ME@HOST:5432/DBNAME?sslmode=require&schema=public

# Generate with: openssl rand -base64 48
SESSION_SECRET=<generate-with-openssl>
SESSION_COOKIE_NAME=curenear_session

S3_ENDPOINT=https://CHANGE_ME.s3.amazonaws.com
S3_REGION=CHANGE_ME
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false

DOCUMENT_SCAN_ENABLED=false
CLAMAV_HOST=CHANGE_ME
CLAMAV_PORT=3310

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_FROM=no-reply@CHANGE_ME.example.com
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

PUBLIC_CONFIRMATION_LINK_ENABLED=false

OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=10000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=30
DEAD_LETTER_RETENTION_DAYS=90
STALE_DRAFT_DAYS=7
WEBHOOK_MAX_ATTEMPTS=8

EXPORT_MAX_ROWS=50000
EXPORT_RETENTION_HOURS=24
EXPORT_JOBS_PER_RUN=5

AGGREGATOR_WEBHOOK_URL=
AGGREGATOR_WEBHOOK_TOKEN=

# One-off bootstrap only. Use a unique password, sign in immediately, change it,
# then delete these three variables from the environment.
SEED_ADMIN_EMAIL=CHANGE_ME@example.com
SEED_ADMIN_NAME="Portal Admin"
SEED_ADMIN_PASSWORD=CHANGE_ME
