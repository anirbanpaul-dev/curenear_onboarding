# Copy to .env, apps/web/.env.local, apps/worker/.env and packages/db/.env.
# Next.js, Prisma and the worker each load their own file. Never commit a real one.
# Every server variable below is validated by Zod at startup.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (docker compose service: db)
DATABASE_URL=postgresql://curenear:curenear@localhost:5432/curenear?schema=public

# Session handling. SESSION_SECRET must be at least 32 characters.
# Sessions slide for 8 hours after each use, with a hard 24-hour cap.
SESSION_SECRET=dev-session-secret-change-me-at-least-32-chars
SESSION_COOKIE_NAME=curenear_session

# S3-compatible object storage (docker compose service: minio, console on :9001)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=curenear
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Document malware scanning. Leave disabled in development; the ClamAV provider
# is a stub and enabling it rejects uploads until it is implemented.
DOCUMENT_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Outbound mail (docker compose service: mailpit, UI on :8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@curenear.local
SMTP_USER=
SMTP_PASSWORD=

# Public tokenised confirmation links (/confirm/[token]). Off by default; the
# page needs no login and is rate limited. Turn on only after sign-off.
PUBLIC_CONFIRMATION_LINK_ENABLED=false

# Worker outbox dispatch
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=10000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=30
DEAD_LETTER_RETENTION_DAYS=90
STALE_DRAFT_DAYS=7
WEBHOOK_MAX_ATTEMPTS=8

# CSV exports (worker). A request above the row cap fails with a message asking
# for narrower filters; files stay downloadable for the retention window.
EXPORT_MAX_ROWS=50000
EXPORT_RETENTION_HOURS=24
EXPORT_JOBS_PER_RUN=5

# Consumer-aggregator delivery (worker). Leave blank to log events only.
AGGREGATOR_WEBHOOK_URL=
AGGREGATOR_WEBHOOK_TOKEN=

# Seed/bootstrap admin (used by `pnpm db:seed` only).
SEED_ADMIN_EMAIL=admin@curenear.in
SEED_ADMIN_NAME="Portal Admin"
SEED_ADMIN_PASSWORD=change-this-dev-password
